{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "PetWhenuaApp",
    "Audience": "PetWhenuaUsers",
    "ExpirationMinutes": "1440"
  },
  "ImageUpload": {
    "MaxFileSize": 5242880,
    "TargetFileSize": 2097152,
    "MaxImagesPerPost": 9,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "CompressionQuality": 75,
    "MaxWidth": 1000,
    "MaxHeight": 667,
    "UploadPath": "/home/site/wwwroot/uploads/posts",
    "ProfilePictureMaxFileSize": 2097152,
    "UserProfilePictureSize": 300,
    "PetProfilePictureSize": 250,
    "UserProfilePicturePath": "/home/site/wwwroot/uploads/profiles/users",
    "PetProfilePicturePath": "/home/site/wwwroot/uploads/profiles/pets",
    "ProfilePictureCompressionQuality": 85
  }
}