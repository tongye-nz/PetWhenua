{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PetWhenuaDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "JwtSettings": {
    "SecretKey": "YourDevelopmentSecretKeyHere123456789012345678901234567890"
  },
  "MockData": {
    "EnableAutoSeed": true,
    "ForceRecreateOnStartup": false,
    "UseLocalImages": true,
    "ImageBasePath": "/uploads/samples/",
    "PetImageCount": { "cats": 3, "dogs": 4 },
    "UserImageCount": 5,
    "PostImageCount": 5,
    "SmartImageAssignment": true,
    "AvoidDuplicatesInLocation": true
  }
}
