{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PetWhenuaDb;Trusted_Connection=true;MultipleActiveResultSets=true;"
  },
  "JwtSettings": {
    "Issuer": "PetWhenuaApp",
    "Audience": "PetWhenuaUsers",
    "ExpirationMinutes": "1440"
  },
  "ImageUpload": {
    "MaxFileSize": 5242880,
    "TargetFileSize": 2097152,
    "MaxImagesPerPost": 9,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "CompressionQuality": 75,
    "MaxWidth": 1000,
    "MaxHeight": 667,
    "UploadPath": "wwwroot/uploads/posts",
    "ProfilePictureMaxFileSize": 2097152,
    "UserProfilePictureSize": 300,
    "PetProfilePictureSize": 250,
    "UserProfilePicturePath": "wwwroot/uploads/profiles/users",
    "PetProfilePicturePath": "wwwroot/uploads/profiles/pets",
    "ProfilePictureCompressionQuality": 85
  }
}
